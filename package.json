{
  "name": "space-samurai",
  "version": "0.1.0",
  "description": "Neon cyber-samurai action game for the browser.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:smoke": "npm run test:smoke:boot && npm run test:smoke:loop",
    "test:smoke:boot": "node tests/smoke/boot.cjs",
    "test:smoke:loop": "node tests/smoke/loop.cjs",
    "pull:assets": "node scripts/pull-assets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Canop3n3r/space-samurai.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Canop3n3r/space-samurai/issues"
  },
  "homepage": "https://github.com/Canop3n3r/space-samurai#readme",
  "private": "true",
  "dependencies": {
    "three": "^0.170.0",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
